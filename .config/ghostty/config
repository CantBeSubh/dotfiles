# ~/.config/ghostty/config

# Window
window-padding-x = 16
window-padding-y = 14
window-decoration = false
maximize = true
background-opacity = 0.75
background-blur = true

# Font — Victor Mono gives the cursive italic (Operator Mono stand-in).
# Set ONLY the family; Ghostty auto-selects the Italic face for italic text.
# Do NOT set font-family-italic or font-style-italic — those override and
# break the automatic cursive-italic selection.

font-family = "FiraCode Nerd Font"
font-family-italic = "VictorMono Nerd Font Mono"
font-family-bold = "FiraCode Nerd Font"
font-family-bold-italic = "VictorMono Nerd Font Mono"
font-size = 14

# Colors
background = 1e2127
foreground = ffffff

# Normal (0-7)
palette = 0=1e2127
palette = 1=e06c75
palette = 2=98c379
palette = 3=d19a66
palette = 4=61afef
palette = 5=c678dd
palette = 6=56b6c2
palette = 7=828791

# Bright (8-15)
palette = 8=5c6370
palette = 9=e06c75
palette = 10=98c379
palette = 11=d19a66
palette = 12=61afef
palette = 13=c678dd
palette = 14=56b6c2
palette = 15=e6efff

# Cursor
cursor-style = bar
cursor-style-blink = true
cursor-color = ffffff
cursor-text = 1e2127

# Selection
selection-background = 3e4451
selection-foreground = ffffff

# Keybindings (readline-style line/word navigation and deletion)
keybind = cmd+left=text:\x1bOH
keybind = cmd+right=text:\x1bOF
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf
keybind = cmd+backspace=text:\x15
keybind = alt+backspace=text:\x1b\x7f

desktop-notifications = true

# Unbind digit variants
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind

# Unbind standard number variants
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind

keybind = ctrl+shift+tab=unbind
keybind = super+t=unbind

keybind = ctrl+tab=text:\x1b[27;5;9~
keybind = ctrl+shift+tab=text:\x1b[27;6;9~
